<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <net.fosterish.prongs.TuningMeterView
            android:id="@+id/meter"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/modeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/octaveLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="1dp"
            android:text="@string/octave_label"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <net.fosterish.prongs.OctaveStripView
            android:id="@+id/octaveStrip"
            android:layout_width="match_parent"
            android:layout_height="@dimen/octave_strip_height"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <net.fosterish.prongs.PianoKeyboardView
            android:id="@+id/keyboard"
            android:layout_width="match_parent"
            android:layout_height="@dimen/keyboard_height"
            android:layout_marginStart="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="6dp" />

        <include
            layout="@layout/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/infoButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/info_action"
        android:padding="11dp"
        android:src="@drawable/ic_info"
        android:tint="@color/text_secondary" />

    <include layout="@layout/permission_panel" />

</FrameLayout>
